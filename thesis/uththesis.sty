\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{uththesis}[2026/07/29 UTH master thesis style]

\RequirePackage[a4paper,left=3cm,right=2cm,top=2.5cm,bottom=2.5cm,headsep=0.65cm]{geometry}
\RequirePackage{fontspec}
\IfFontExistsTF{Times New Roman}{
  \setmainfont{Times New Roman}
}{
  \IfFontExistsTF{TeX Gyre Termes}{\setmainfont{TeX Gyre Termes}}{\setmainfont{Liberation Serif}}
}
\RequirePackage[vietnamese,english]{babel}
\RequirePackage{setspace}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{subcaption}
\RequirePackage{caption}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{pdflscape}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{makecell}
\RequirePackage{siunitx}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{bm}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{groupplots}
\RequirePackage{enumitem}
\RequirePackage{csquotes}
\RequirePackage{microtype}
\RequirePackage{ragged2e}
\RequirePackage{etoolbox}
\RequirePackage{xparse}
\RequirePackage{tocloft}
\RequirePackage{chngcntr}
\RequirePackage{hyperref}
\RequirePackage[nameinlink,noabbrev]{cleveref}
\RequirePackage[backend=biber,style=ieee,sorting=none,giveninits=true,maxbibnames=99]{biblatex}

\AtBeginDocument{\fontsize{13}{19.5}\selectfont}
\setstretch{1.5}
\setlength{\parindent}{1.27cm}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{2em}
\setlength{\headheight}{15pt}
\justifying

% Headings required by UTH guideline.
\titleformat{\chapter}[block]
  {\centering\bfseries\fontsize{14}{17}\selectfont}
  {CHƯƠNG~\thechapter.}{0.6em}{\MakeUppercase}
\titlespacing*{\chapter}{0pt}{-8pt}{20pt}
\titleformat{name=\chapter,numberless}[block]
  {\centering\bfseries\fontsize{14}{17}\selectfont}
  {}{0pt}{\MakeUppercase}
\titlespacing*{name=\chapter,numberless}{0pt}{-8pt}{20pt}

\titleformat{\section}
  {\bfseries\fontsize{13}{16}\selectfont}
  {\thesection.}{0.55em}{}
\titlespacing*{\section}{0pt}{12pt}{4pt}
\titleformat{\subsection}
  {\itshape\fontsize{13}{16}\selectfont}
  {\thesubsection.}{0.55em}{}
\titlespacing*{\subsection}{0pt}{10pt}{3pt}
\titleformat{\subsubsection}
  {\normalfont\fontsize{13}{16}\selectfont}
  {\alph{subsubsection}.}{0.55em}{}
\titlespacing*{\subsubsection}{0pt}{8pt}{2pt}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}

% Page numbers at top center, continuous from Introduction through References.
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyhead[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% Caption layout.
\captionsetup{font={normalsize},labelfont=bf,textfont=bf,labelsep=period}
\captionsetup[figure]{position=bottom,justification=centering,singlelinecheck=false,skip=6pt}
\captionsetup[table]{position=top,justification=raggedright,singlelinecheck=false,skip=6pt}
\renewcommand{\figurename}{Hình}
\renewcommand{\tablename}{Bảng}
\counterwithin{figure}{chapter}
\counterwithin{table}{chapter}
\counterwithin{equation}{chapter}

% TOC/list typography.
\renewcommand{\contentsname}{MỤC LỤC}
\renewcommand{\listfigurename}{DANH MỤC HÌNH ẢNH}
\renewcommand{\listtablename}{DANH MỤC BẢNG}
\setlength{\cftbeforechapskip}{3pt}
\setlength{\cftbeforesecskip}{0pt}
\renewcommand{\cftchapfont}{\bfseries}
\renewcommand{\cftchappagefont}{\bfseries}

% Hyperlinks are black in printed thesis.
\hypersetup{
  unicode=true,
  colorlinks=true,
  linkcolor=black,
  citecolor=black,
  urlcolor=black,
  pdfborder={0 0 0}
}

% Table helpers.
\newcolumntype{Y}{>{\RaggedRight\arraybackslash}X}
\newcolumntype{C}{>{\Centering\arraybackslash}X}
\newcolumntype{R}{>{\RaggedLeft\arraybackslash}X}
\sisetup{output-decimal-marker={,},group-separator={.},group-minimum-digits=4}

% Figure/table source notes.
\newcommand{\figuresource}[1]{%
  \par\vspace{-2pt}\begin{flushright}\fontsize{12}{14}\selectfont\itshape Nguồn: #1\end{flushright}
}
\newcommand{\tablesource}[1]{%
  \par\vspace{-4pt}\begin{flushright}\fontsize{12}{14}\selectfont\itshape Nguồn: #1\end{flushright}
}

% Draw.io figure inclusion with printable width and height limits.
\NewDocumentCommand{\ThesisFigure}{m m m O{0.88\textwidth}}{%
  \begin{figure}[H]
    \centering
    \IfFileExists{#1}{%
      \includegraphics[width=#4,height=0.74\textheight,keepaspectratio]{#1}%
    }{%
      \fbox{%
        \begin{minipage}[c][6.6cm][c]{0.86\textwidth}
          \centering
          \bfseries HÌNH MINH HỌA ĐANG CHỜ DRAW.IO\\[6pt]
          \normalfont Tệp dự kiến: \texttt{\detokenize{#1}}\\[5pt]
          Xem đặc tả trong \texttt{DRAWIO\_FIGURE\_SPEC.md}.
        \end{minipage}%
      }%
    }
    \caption{#2}
    \label{#3}
  \end{figure}
}

% Code style.
\lstdefinestyle{thesispython}{
  language=Python,
  basicstyle=\ttfamily\fontsize{10.5}{13}\selectfont,
  keywordstyle=\bfseries,
  commentstyle=\itshape,
  numbers=left,
  numberstyle=\tiny,
  stepnumber=1,
  numbersep=7pt,
  frame=single,
  breaklines=true,
  showstringspaces=false,
  tabsize=4
}

% Algorithm naming.
\floatname{algorithm}{Thuật toán}
\algrenewcommand\algorithmicrequire{\textbf{Đầu vào:}}
\algrenewcommand\algorithmicensure{\textbf{Đầu ra:}}
\algrenewcommand\algorithmicwhile{\textbf{trong khi}}
\algrenewcommand\algorithmicdo{\textbf{thực hiện}}
\algrenewcommand\algorithmicfor{\textbf{với}}
\algrenewcommand\algorithmicforall{\textbf{với mọi}}
\algrenewcommand\algorithmicif{\textbf{nếu}}
\algrenewcommand\algorithmicthen{\textbf{thì}}
\algrenewcommand\algorithmicelse{\textbf{ngược lại}}
\algrenewcommand\algorithmicreturn{\textbf{trả về}}

% Convenience environments.
\newenvironment{researchquestion}{\begin{quote}\itshape}{\end{quote}}
\newcommand{\Rsum}{R_{\mathrm{sum}}}
\newcommand{\QoS}{\mathrm{QoS}}
\newcommand{\E}{\mathbb{E}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
